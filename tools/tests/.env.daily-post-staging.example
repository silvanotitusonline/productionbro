# Copy to a local, untracked file before running the load test.
# Never commit a real database password or service key.
SUPABASE_TEST_PROJECT_REF=eqwstpdjoineycrkhpht
SUPABASE_TEST_DB_URL=postgresql://postgres:<NONPRODUCTION_DB_PASSWORD>@db.eqwstpdjoineycrkhpht.supabase.co:5432/postgres?sslmode=require
# Optional: if omitted, the script selects the newest published Daily Post.
DAILY_POST_LOAD_POST_ID=
# Optional bounded pgbench run; leave disabled for query-plan-only checks.
RUN_PGBENCH=0
PGBENCH_CLIENTS=4
PGBENCH_JOBS=2
PGBENCH_SECONDS=30
